@{
    ViewData["Title"] = "多項評級合併";
}
<div class="rating-page mx-auto">
    <form id="combine-ratings" class="card border-0 shadow-sm"
          asp-area="Frontend" asp-controller="CombinedRatingsApi" asp-action="Calculate" method="post">
        <div class="card-body p-3 p-md-4">
            <label for="ratings" class="form-label">評級百分比</label>
            <input id="ratings" name="ratings" class="form-control" type="text" placeholder="例如 15,18,35"
                   aria-describedby="ratings-note" required />
            <div id="ratings-note" class="form-text">請輸入已確認可合併、且尺度相同的評級，以逗號分隔。</div>
            <p id="combine-error" class="text-danger mt-2 mb-0" role="alert" hidden></p>
            <div class="d-grid d-md-flex mt-3">
                <button type="submit" class="btn btn-primary px-4">合併計算</button>
            </div>
        </div>
    </form>

    <section id="combine-result" class="card border-0 shadow-sm mt-4" tabindex="-1" aria-labelledby="combine-title" hidden>
        <div class="card-body p-3 p-md-4">
            <h1 id="combine-title" class="h5">合併評級</h1>
            <p id="combined-percent" class="display-5 text-primary fw-semibold"></p>
            <ol id="combined-steps" class="mb-0"></ol>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/combined-ratings.js" asp-append-version="true"></script>
}

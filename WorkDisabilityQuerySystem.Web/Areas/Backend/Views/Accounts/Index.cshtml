@using System.Security.Claims
@using WorkDisabilityQuerySystem.Domain.Accounts
@{
    ViewData["Title"] = "帳號管理";
}
<section id="account-management" class="account-grid" aria-label="帳號管理"
         data-list-url="@Url.Action("List", "AccountsApi")"
         data-profile-url="@Url.Action("UpdateProfile", "AccountsApi")"
         data-current-id="@User.FindFirstValue(ClaimTypes.NameIdentifier)"
         data-admin-level="@Account.AdministratorLevel" data-user-level="@Account.UserLevel">
    <form id="account-filter" class="account-toolbar">
        <div class="account-search">
            <label for="account-keyword" class="form-label">帳號搜尋</label>
            <input id="account-keyword" class="form-control" type="search" placeholder="輸入帳號或姓名" />
        </div>
        <div>
            <label for="account-level-filter" class="form-label">角色</label>
            <select id="account-level-filter" class="form-select">
                <option value="">全部角色</option>
                <option value="@Account.UserLevel">一般使用者</option>
                <option value="@Account.AdministratorLevel">管理員</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">查詢</button>
            <button type="reset" class="btn wdqs-outline">清除</button>
        </div>
        <button id="open-create-account" type="button" class="btn account-add">＋ 新增帳號</button>
    </form>

    <div class="table-responsive">
        <table class="table account-table align-middle mb-0">
            <thead>
                <tr><th scope="col">序號</th><th scope="col">帳號</th><th scope="col">姓名</th><th scope="col">角色</th><th scope="col" class="text-end">操作</th></tr>
            </thead>
            <tbody id="account-list"></tbody>
        </table>
    </div>
    <div id="account-pagination" class="account-footer justify-content-end" hidden>
        <nav id="account-pages" aria-label="帳號列表分頁"></nav>
    </div>
    <p id="account-list-status" class="small px-3 mb-2" role="status" hidden></p>
</section>

<dialog id="create-account-dialog" class="account-dialog" aria-labelledby="create-account-heading">
    <form id="create-account-form" asp-area="Backend" asp-controller="AccountsApi" asp-action="Create" method="post">
        <h2 id="create-account-heading" class="h5 mb-3">新增帳號</h2>
        <label for="new-username" class="form-label">帳號</label>
        <input id="new-username" name="Username" class="form-control mb-3" maxlength="50" autocomplete="off" required />
        <label for="new-display-name" class="form-label">姓名</label>
        <input id="new-display-name" name="DisplayName" class="form-control mb-3" maxlength="100" />
        <label for="new-password" class="form-label">密碼</label>
        <input id="new-password" name="Password" class="form-control" type="password" minlength="12" maxlength="72"
               autocomplete="new-password" aria-describedby="password-requirements" required />
        <small id="password-requirements" class="form-text d-block mb-3">至少 12 字元，UTF-8 最多 72 位元組。</small>
        <label for="new-level" class="form-label">角色</label>
        <select id="new-level" name="Level" class="form-select">
            <option value="@Account.UserLevel">一般使用者</option>
            <option value="@Account.AdministratorLevel">管理員</option>
        </select>
        <p class="small mb-0 mt-2" data-dialog-status role="status"></p>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn wdqs-outline" data-close-dialog>取消</button>
            <button type="submit" class="btn btn-primary">新增</button>
        </div>
    </form>
</dialog>

<dialog id="edit-account-dialog" class="account-dialog" aria-labelledby="edit-account-heading">
    <form id="edit-account-form">
        <h2 id="edit-account-heading" class="h5 mb-3">編輯帳號</h2>
        <p data-account-name></p>
        <input type="hidden" name="AccountId" />
        <label for="edit-display-name" class="form-label">姓名</label>
        <input id="edit-display-name" name="DisplayName" class="form-control mb-3" maxlength="100" />
        <label for="edit-level" class="form-label">角色</label>
        <select id="edit-level" name="Level" class="form-select">
            <option value="@Account.UserLevel">一般使用者</option>
            <option value="@Account.AdministratorLevel">管理員</option>
        </select>
        <p class="small mb-0 mt-2" data-dialog-status role="status"></p>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn wdqs-outline" data-close-dialog>取消</button>
            <button type="submit" class="btn btn-primary">儲存</button>
        </div>
    </form>
</dialog>

<dialog id="delete-account-dialog" class="account-dialog" aria-labelledby="delete-account-heading">
    <form id="delete-account-form">
        <h2 id="delete-account-heading" class="h5 mb-3">刪除帳號</h2>
        <p>確定要永久刪除帳號 <strong data-account-name></strong> 嗎？</p>
        <input type="hidden" name="AccountId" />
        <p class="small mb-0" data-dialog-status role="status"></p>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn wdqs-outline" data-close-dialog autofocus>取消</button>
            <button type="submit" class="btn btn-danger">確認刪除</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/account-management.js" asp-append-version="true"></script>
}

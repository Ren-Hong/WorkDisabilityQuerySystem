@model WorkDisabilityQuerySystem.Web.Areas.Auth.Models.LoginInput
@{
    ViewData["Title"] = "登入";
}
<section class="wdqs-login-card" aria-labelledby="login-title">
    <img class="wdqs-login-logo" src="~/img/wdqs-logo.png" asp-append-version="true" width="192" height="192" alt="" />
    <h1 id="login-title">職災失能查表系統</h1>
    <form asp-area="Auth" asp-controller="Login" asp-action="Index" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="wdqs-login-field mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="wdqs-login-field mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2">登入</button>
    </form>
</section>
